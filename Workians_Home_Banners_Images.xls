<Worksheet ss:Name="Dynamic Sections"><Table><Row><Cell><Data ss:Type="String">Category</Data></Cell><Cell><Data ss:Type="String">Section</Data></Cell><Cell><Data ss:Type="String">Source</Data></Cell><Cell><Data ss:Type="String">Desktop_Display</Data></Cell><Cell><Data ss:Type="String">Mobile_Display</Data></Cell><Cell><Data ss:Type="String">Aspect_Ratio</Data></Cell><Cell><Data ss:Type="String">Notes</Data></Cell></Row><Row><Cell><Data ss:Type="String">Dynamic Section Image</Data></Cell><Cell><Data ss:Type="String">Top picks main</Data></Cell><Cell><Data ss:Type="String">API project primaryImage</Data></Cell><Cell><Data ss:Type="String">Height ~420px (up to ~720px on large screens)</Data></Cell><Cell><Data ss:Type="String">Responsive height within carousel</Data></Cell><Cell><Data ss:Type="String">Cover / object-fit cover</Data></Cell><Cell><Data ss:Type="String">Not a static asset file</Data></Cell></Row><Row><Cell><Data ss:Type="String">Dynamic Section Image</Data></Cell><Cell><Data ss:Type="String">Property / Project cards</Data></Cell><Cell><Data ss:Type="String">API listing/project images</Data></Cell><Cell><Data ss:Type="String">16:10 card image; ~4 columns grid</Data></Cell><Cell><Data ss:Type="String">16:10; horizontal scroll cards ~78% width, max ~300px</Data></Cell><Cell><Data ss:Type="String">16:10</Data></Cell><Cell><Data ss:Type="String">Not a static asset file</Data></Cell></Row></Table></Worksheet>
<Worksheet ss:Name="Design Guide"><Table><Row><Cell><Data ss:Type="String">Topic</Data></Cell><Cell><Data ss:Type="String">Detail</Data></Cell></Row><Row><Cell><Data ss:Type="String">Recommended hero banner export</Data></Cell><Cell><Data ss:Type="String">2880 x 972 px (approx 3:1). Keep focal subject on the RIGHT; left side calmer for headline + search.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Recommended logo export</Data></Cell><Cell><Data ss:Type="String">About 900 x 250 px wide lockup. Displayed at 38-46px tall in header.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Recommended icon export</Data></Cell><Cell><Data ss:Type="String">Square; source ideally 128 x 128 (or at least 64 x 64). Shown at 32-48px.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Hero display behavior</Data></Cell><Cell><Data ss:Type="String">background-size: cover — fills width; top/bottom may crop. Height is fluid (min-height), not a fixed crop box.</Data></Cell></Row><Row><Cell><Data ss:Type="String">Desktop hero area</Data></Cell><Cell><Data ss:Type="String">Full viewport width x roughly 544-560px (64px header + ~480px hero).</Data></Cell></Row><Row><Cell><Data ss:Type="String">Mobile hero area</Data></Cell><Cell><Data ss:Type="String">Full width x roughly 340-400px; background shifts toward right.</Data></Cell></Row></Table></Worksheet>
