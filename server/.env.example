NODE_ENV=development
APP_NAME=Workians
APP_URL=http://localhost:5173
# Optional: force email links to a fixed LAN URL (auto-detected in dev if omitted)
# LAN_APP_URL=http://192.168.100.64:5173
API_URL=http://localhost:5000
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hous_db

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long!!
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

SUPER_ADMIN_EMAIL=superadmin@hous.local
SUPER_ADMIN_PASSWORD=SuperAdmin@12345

# Email verification link expiry (minutes)
EMAIL_VERIFICATION_EXPIRES_MINUTES=5

# Gmail SMTP — create an App Password: https://myaccount.google.com/apppasswords
# Leave MAIL_HOST empty to log emails to the server console in development.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM="Workians <your@gmail.com>"

UPLOAD_DIR=../uploads
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
